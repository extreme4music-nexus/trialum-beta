<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Keep the world and its private conversation memory on this device only.
         Google Play Games remains a separate, opt-in path with filtered snapshots. -->
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
